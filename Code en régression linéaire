import pandas as pd
from sklearn.linear_model import LinearRegression

chemin_fichier = "Dataset_Start&Go_UniversalAssay.xlsm"

try:
    # 1. Charger la feuille 'Tree_Sigma_Full'
    nom_feuille = "Tree_Sigma_Full"
    df_raw = pd.read_excel(chemin_fichier, sheet_name=nom_feuille, header=None)

    # Substrats (ligne 8) et métadonnées enzymes (ligne 16)
    noms_substrats = df_raw.iloc[7, 13:].values
    noms_enzymes_meta = [str(col).strip() for col in df_raw.iloc[15, 7:13].values]

    # Découpage strict de la ligne 18 à la ligne 482
    row_debut = 17
    row_fin = 482

    df_enzymes = df_raw.iloc[row_debut:row_fin, 7:13].copy()
    df_enzymes.columns = noms_enzymes_meta

    df_activite = df_raw.iloc[row_debut:row_fin, 13:].copy()
    df_activite.columns = noms_substrats

    # Assemblage de la grille
    df_grid = pd.concat([df_enzymes.reset_index(drop=True), df_activite.reset_index(drop=True)], axis=1)

    # Garder uniquement les lignes valides (avec un Acc. Number)
    df_grid = df_grid.dropna(subset=['Acc. Number'])

    # 2. Transformation au format LONG
    cols_meta = list(noms_enzymes_meta)
    df_ml = pd.melt(df_grid, id_vars=cols_meta, var_name='Substrat', value_name='Activite')

    # 3. VERIFICATION : Isoler explicitement les lignes à prédire (contenant '???')
    mask_a_predire = df_ml['Activite'].astype(str).str.contains(r'\?', na=False) | (df_ml['Acc. Number'] == 'Q5N2G0')

    df_a_predire = df_ml[mask_a_predire].copy()
    df_connues = df_ml[~mask_a_predire].copy()

    # Pour le jeu d'entraînement, on convertit l'activité en nombre et on enlève les NaN
    df_connues['Activite'] = pd.to_numeric(df_connues['Activite'], errors='coerce')
    df_connues = df_connues.dropna(subset=['Activite'])

    print(f"Lignes d'apprentissage disponibles (données mesurées) : {len(df_connues)}")
    print(f"Lignes à prédire pour la ligne 111 (Q5N2G0) : {len(df_a_predire)}")

    # Sauvegarder deux fichiers distincts
    df_connues.to_csv("dataset_train.csv", index=False)
    df_a_predire.to_csv("dataset_a_predire.csv", index=False)
    print("\nDeux fichiers créés : 'dataset_train.csv' et 'dataset_a_predire.csv'.")

except Exception as e:
    print(f"Erreur lors de l'extraction : {e}")


# ==========================================================
# Étape : Régression Multiple (Bradford + Substrats)
# ==========================================================

# 1. Charger les données
df_train = pd.read_csv("dataset_train.csv")
df_pred = pd.read_csv("dataset_a_predire.csv")

# Nettoyage automatique des noms de colonnes (suppression des espaces)
df_train.columns = df_train.columns.str.strip()
df_pred.columns = df_pred.columns.str.strip()

# Recherche dynamique de la colonne Bradford
col_bradford_train = next((c for c in df_train.columns if 'bradford' in c.lower()), None)
col_bradford_pred = next((c for c in df_pred.columns if 'bradford' in c.lower()), None)

if not col_bradford_train:
    raise ValueError(f"Impossible de trouver la colonne Bradford dans dataset_train. Colonnes dispo : {df_train.columns.tolist()}")

# Conversion propre du Bradford en nombre
df_train[col_bradford_train] = pd.to_numeric(df_train[col_bradford_train], errors='coerce').fillna(0)
df_pred[col_bradford_pred] = pd.to_numeric(df_pred[col_bradford_pred], errors='coerce').fillna(0)

# 2. Encodage des Substrats (One-Hot Encoding)
# Combine temporairement pour s'assurer d'avoir les mêmes colonnes de substrats
df_all = pd.concat([df_train[[col_bradford_train, 'Substrat']], df_pred[[col_bradford_pred, 'Substrat']]], axis=0)
df_all_encoded = pd.get_dummies(df_all, columns=['Substrat'], drop_first=False)

# Séparation après encodage
X_train = df_all_encoded.iloc[:len(df_train)].copy()
X_pred = df_all_encoded.iloc[len(df_train):].copy()

y_train = df_train['Activite']

# 3. Créer et entraîner le modèle (Régression Linéaire Multiple)
modele = LinearRegression()
modele.fit(X_train, y_train)

# 4. Prédire pour la ligne 111
df_pred['Activite_Predite'] = modele.predict(X_pred)

# 5. Afficher le résultat
print("\n--- Résultats de la régression (basée sur le Bradford ET le Substrat) ---")
print(df_pred[['Acc. Number', 'Substrat', col_bradford_pred, 'Activite_Predite']].head(15))

# Sauvegarde finale des prédictions
df_pred.to_csv("resultat_regression_bradford_substrat.csv", index=False)
print("\nRésultats enregistrés dans 'resultat_regression_bradford_substrat.csv' !")
